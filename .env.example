# Contact form (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
# Address that receives contact-form messages
CONTACT_TO_EMAIL=you@example.com
# Verified sender in Resend (use onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Public site URL (used for sitemap, OG and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
